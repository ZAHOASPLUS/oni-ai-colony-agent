            "type": "command_ack",
            "data": {
              "schema": "oni.event.v2",
              "event": "command_ack",
              "id": "cmd-independent-witness-pass",
              "attempt_id": "attempt-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
              "action": "set_paused",
              "status": "accepted",
              "stage": "accepted",
              "seq": 11
            }
          }
        ],
        "state": {
          "oni.action.accepted_ack_seq": 11,
          "oni.action.executor_status": "accepted"
        }
      },
      "expect": {
        "events": [
          "command_ack"
        ],
        "forbid_events": [
          "oni.action.snapshot_confirmed"
        ],
        "state": {
          "oni.action.accepted_ack_seq": 11,
          "oni.action.executed_ack_seq": 0,
          "oni.action.executor_status": "accepted",
          "oni.action.confirmation_status": "pending"
        },
        "timeout_ms": 200
      }
    },
    {
      "id": "archive_executed_ack",
      "action": {
        "type": "mock",
        "events": [
          {
            "type": "command_ack",
            "data": {
              "schema": "oni.event.v2",
              "event": "command_ack",
              "id": "cmd-independent-witness-pass",
              "attempt_id": "attempt-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
              "action": "set_paused",
              "status": "executed",
              "stage": "executed",
              "seq": 12
            }
          }
        ],
        "state": {
          "oni.action.executed_ack_seq": 12,
          "oni.action.executor_status": "executed"
        }
      },
      "expect": {
        "events": [
          "command_ack"
        ],
        "forbid_events": [
          "oni.action.snapshot_confirmed"
        ],
        "state": {
          "oni.action.accepted_ack_seq": 11,
          "oni.action.executed_ack_seq": 12,
          "oni.action.local_effect_ack_seq": 0,
          "oni.action.executor_status": "executed"
        },
        "timeout_ms": 200
      }
    },
    {
      "id": "archive_local_effect_observed_ack_and_enter_confirming",
      "action": {
        "type": "mock",
        "events": [
          {
            "type": "command_ack",
            "data": {
              "schema": "oni.event.v2",
              "event": "command_ack",
              "id": "cmd-independent-witness-pass",
              "attempt_id": "attempt-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
              "action": "set_paused",
              "status": "local_effect_observed",
              "stage": "local_effect_observed",
              "seq": 13
            }
          }
        ],
        "state": {
          "oni.action.local_effect_ack_seq": 13,
          "oni.action.command_location": "confirming",
          "oni.action.executor_status": "executed_pending_snapshot",
          "oni.action.confirmation_status": "awaiting_trusted_snapshot",
          "oni.action.direct_effect_observed": true
        }
      },
      "expect": {
        "events": [
          "command_ack"
        ],
        "forbid_events": [
          "oni.action.snapshot_confirmed"
        ],
        "state": {
          "oni.action.accepted_ack_seq": 11,
          "oni.action.executed_ack_seq": 12,
          "oni.action.local_effect_ack_seq": 13,
          "oni.action.command_location": "confirming",
          "oni.action.executor_status": "executed_pending_snapshot",
          "oni.action.confirmation_status": "awaiting_trusted_snapshot",
          "oni.action.direct_effect_observed": true,
          "oni.action.expected_effect": false,
          "oni.action.witness_trusted": false
        },
        "timeout_ms": 200
      }
    },
    {
      "id": "publish_independent_later_witness_and_confirm",
      "action": {
        "type": "mock",
        "events": [
          {
            "type": "oni.state_snapshot",
            "data": {
              "seq": 14,
              "snapshot_seq": 2,
              "source": "probe"
            }
          },
          {
            "type": "oni.action.snapshot_confirmed",
            "data": {
              "id": "cmd-independent-witness-pass",
              "attempt_id": "attempt-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
              "local_effect_ack_seq": 13,
              "witness_seq": 14
            }
          }
        ],
        "state": {
          "oni.action.witness_event_seq": 14,
          "oni.action.witness_snapshot_seq": 2,
          "oni.action.witness_source": "probe",
          "oni.action.witness_trusted": true,
          "oni.action.expected_effect": true,
          "oni.action.confirmation_status": "snapshot_confirmed"
        }
      },
      "expect": {
        "events": [
          "oni.state_snapshot",
          "oni.action.snapshot_confirmed"
        ],
        "state": {
          "oni.action.accepted_ack_seq": 11,
          "oni.action.executed_ack_seq": 12,
          "oni.action.local_effect_ack_seq": 13,
          "oni.action.witness_event_seq": 14,
          "oni.action.executor_status": "executed_pending_snapshot",
          "oni.action.confirmation_status": "snapshot_confirmed",
          "oni.action.witness_source": "probe",
          "oni.action.witness_trusted": true,
          "oni.action.expected_effect": true
        },
        "state_delta": {
          "oni.action.witness_snapshot_seq": 1
        },
        "timeout_ms": 200
      }
    }
  ]
