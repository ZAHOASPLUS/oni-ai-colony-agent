{
  "id": "oni_action_outcome_snapshot_confirmed",
  "title": "Ordered command ACKs enter confirming before a later Probe snapshot confirms the ONI action",
  "profile": "mock-oni",
  "game": "Oxygen Not Included",
  "mod": "oni-ai-colony-agent",
  "failure_class": {
    "missing_expected_event": "behavior_fail",
    "state_mismatch": "behavior_fail",
    "state_delta_mismatch": "behavior_fail",
    "visual_missing": "visual_fail"
  },
  "evidence": {
    "events": true,
    "state": true,
    "visuals": false
  },
  "setup": {
    "initial_state": {
      "oni.action.command_id": "cmd-independent-witness-pass",
      "oni.action.attempt_id": "attempt-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "oni.action.source_event_seq": 10,
      "oni.action.source_snapshot_seq": 1,
      "oni.action.accepted_ack_seq": 0,
