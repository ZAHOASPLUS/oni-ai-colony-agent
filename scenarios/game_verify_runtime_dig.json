          },
          {
            "id": "runtime_dig_invalid_target",
            "path": "reports/runtime-markers/dig_designation_invalid_target.passed",
            "state_key": "oni.runtime.dig_designation_invalid_target.passed",
            "pass_event": "oni.runtime.dig_designation_invalid_target.passed"
          }
        ]
      },
      "expect": {
        "events": [
          "oni.runtime.dig_designation.passed",
          "oni.runtime.dig_designation_invalid_target.passed"
        ],
        "state": {
          "oni.runtime.dig_designation.passed": true,
          "oni.runtime.dig_designation_invalid_target.passed": true
        },
        "timeout_ms": 500
      }
    }
  ]
