{
  "schema": "oni.scenarios.v2",
  "scenarios": [
    {
      "name": "low_food",
      "input": "mock_state_low_food.jsonl",
      "expect_advice": [
        "Registered food is below the risk threshold"
      ],
      "expect_commands": [
        "focus_note"
      ],
      "expect_incident_status": {
        "low_food": "open"
      },
      "expect_health_status": "ok"
    },
    {
      "name": "low_oxygen",
      "input": "mock_state_low_oxygen.jsonl",
      "repeat": 7,
      "repeat_interval_seconds": 5,
      "expect_advice": [
        "Oxygen alert observed"
      ],
      "forbid_commands": [
        "set_paused"
      ],
      "expect_incident_status": {
        "low_oxygen": "open"
      }
    },
    {
      "name": "idle_no_research",
      "input": "mock_state_idle_no_research.jsonl",
      "repeat": 2,
      "repeat_interval_seconds": 5,
      "expect_advice": [
        "Duplicants are idle",
        "No active research detected"
      ],
      "expect_commands": [
        "focus_note"
      ],
      "forbid_commands": [
        "set_research"
      ],
      "expect_incident_status": {
        "idle_duplicants": "open",
        "no_active_research": "open"
      }
    },
    {
      "name": "normal_clear",
      "input": "mock_state_normal.jsonl",
      "forbid_advice": [
        "Registered food is below the risk threshold",
        "Oxygen alert observed",
        "Duplicants are idle",
        "No active research detected"
      ],
      "forbid_commands": [
        "focus_note",
        "set_paused",
        "set_research"
      ],
      "expect_health_status": "ok"
    },
    {
      "name": "building_diagnostics",
      "input": "mock_state_building_diagnostics.jsonl",
      "expect_advice": [
        "Missing oxygen diffuser",
        "Missing outhouse",
        "Missing manual generator"
      ],
      "expect_commands": [
        "focus_note"
      ],
      "expect_summary_contains": [
        "Building scan source: typed_active_world",
        "Building samples: Headquarters, Tile, Ladder",
        "Top building prefabs: Tile x2"
      ],
      "expect_incident_status": {
        "missing_oxygen_diffuser": "open",
        "missing_outhouse": "open",
        "missing_manual_generator": "open"
      }
    },
    {
      "name": "unknown_research_is_not_empty",
      "input": "mock_state_unknown_research.jsonl",
      "forbid_advice": [
        "No active research detected"
      ],
      "forbid_commands": [
        "set_research"
      ],
      "expect_summary_contains": [
        "Research: unknown (unsupported)"
      ],
      "expect_incident_status": {
        "no_active_research": "blocked_unknown"
      }
    },
    {
      "name": "duplicant_priority_targets_are_observer_only",
      "input": "mock_state_duplicant_priorities.jsonl",
      "forbid_commands": [
        "set_duplicant_chore_priority"
      ],
      "expect_summary_contains": [
        "## Duplicant Priority Targets",
        "id_123 Ada:",
        "Build=3, Dig=2"
      ],
      "expect_health_status": "ok"
    },
    {
      "name": "dig_designations_are_observer_only",
      "input": "mock_state_dig_designations.jsonl",
      "forbid_commands": [
        "mark_dig_cells",
        "cancel_dig_cells"
      ],
      "expect_summary_contains": [
        "## Dig Designations",
        "Tiles filter: True",
        "Natural backwall filter: False",
        "Safe candidates: 456",
        "cell_456 (12,34) SandStone: safe mark candidate",
        "cell_457 (13,34) SandStone: designation=9001 kind=tile in_progress=False"
      ],
      "expect_health_status": "ok"
    },
    {
      "name": "blueprints_are_observer_only",
      "input": "mock_state_blueprints.jsonl",
      "forbid_commands": [
        "place_building_blueprint",
        "cancel_building_blueprint",
        "place_utility_blueprint_path",
        "cancel_utility_blueprint_path"
      ],
      "expect_summary_contains": [
        "## Blueprint Actions",
        "Sandbox mode: False",
        "Ladder: materials=SandStone; available=True; candidates=500",
        "Wire: materials=Copper; available=True; candidates=600, 601",
        "cell_500 (10,10) Oxygen: safe for Ladder,Wire",
        "cell_600 (20,10) Oxygen: blueprint=9201 prefab=Wire in_progress=False",
        "wirepath1: Wire cells=600 instances=9201 fully_active=True"
      ],
      "expect_health_status": "ok"
    },
    {
      "name": "transient_oxygen_does_not_trigger",
      "input": "mock_state_transient_oxygen.jsonl",
      "repeat": 6,
      "repeat_interval_seconds": 5,
      "forbid_advice": [
        "Oxygen alert observed"
      ],
      "forbid_commands": [
        "set_paused"
      ],
      "expect_incident_status": {
        "low_oxygen": "pending"
      }
    },
    {
      "name": "oxygen_incident_recovers",
      "stream_outputs": true,
      "steps": [
        {
          "input": "mock_state_low_oxygen.jsonl",
          "repeat": 7,
          "repeat_interval_seconds": 5
        },
        {
          "input": "mock_state_normal.jsonl",
          "repeat": 1,
          "repeat_interval_seconds": 5
        }
      ],
      "forbid_advice": [
        "Oxygen alert observed"
      ],
      "forbid_commands": [
        "set_paused"
      ],
      "expect_incident_status": {
        "low_oxygen": "resolved"
      },
      "expect_timeline_events": [
        "incident_opened",
        "incident_resolved"
      ],
      "expect_command_dir_counts": {
        "pending": 0,
        "rejected": 0
      }
    }
  ]
}
