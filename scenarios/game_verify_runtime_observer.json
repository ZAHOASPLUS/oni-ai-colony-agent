{
  "id": "oni_runtime_observer",
  "title": "ONI runtime observer produced a trusted V2 session",
  "profile": "mock-oni",
  "game": "Oxygen Not Included",
  "mod": "oni-ai-colony-agent",
  "failure_class": {
    "missing_expected_event": "behavior_fail",
    "state_mismatch": "behavior_fail",
    "visual_missing": "visual_fail"
  },
  "evidence": {
    "events": true,
    "state": true,
    "visuals": false
  },
  "steps": [
    {
      "id": "probe_observer_acceptance_marker",
      "action": {
        "type": "file_probe",
        "checks": [
          {
            "id": "runtime_observer",
            "path": "reports/runtime-markers/observer_start.passed",
            "state_key": "oni.runtime.observer.passed",
            "pass_event": "oni.runtime.observer.passed"
          }
        ]
      },
      "expect": {
        "events": ["oni.runtime.observer.passed"],
        "state": {"oni.runtime.observer.passed": true},
        "timeout_ms": 500
      }
    }
  ]
}
