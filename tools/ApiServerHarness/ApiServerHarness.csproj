<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ONIManagedDir Condition="'$(ONIManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</ONIManagedDir>
  </PropertyGroup>

  <!-- The exact server source, driven over real loopback sockets. -->
  <ItemGroup>
    <Compile Include="..\..\mod\Source\Api\ApiServer.cs" LinkBase="ModSource" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(ONIManagedDir)\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
