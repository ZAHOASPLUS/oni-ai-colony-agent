{
  "schema": "oni.power-telemetry-contract.v2",
  "version": 2,
  "snapshot": {
    "schema": "oni.state.v2",
    "event": "state_snapshot"
  },
  "extends": {
    "path": "oni_telemetry.v1.json",
    "schema": "oni.telemetry-contract.v1",
    "replaced_fields": [
      "power.stored_joules",
      "power.capacity_joules",
      "power.battery_percent"
    ]
  },
  "limits": {
    "maximum_joules": 1000000000000000000.0,
    "percent_tolerance": 0.001
  },
  "storage_modes": [
    "bounded",
    "unbounded"
  ],
  "blocked_quality": {
    "unsupported": "complete",
    "error": "unknown"
  },
  "quality_contracts": {
    "storage_mode": {
      "statuses": [
        "observed"
      ],
      "source": "Components.Batteries(powerTransformer==null)+EnergyConsumers+Generators(excluding PowerTransformer)",
      "semantic": "storage_capacity_mode",
      "unit": "enum",
      "scope": "active_world_registered_batteries",
      "completeness": "complete",
      "captured_at": "snapshot.ts"
    },
    "stored_joules": {
      "statuses": [
        "observed"
      ],
      "source": "Components.Batteries(powerTransformer==null)+EnergyConsumers+Generators(excluding PowerTransformer)",
      "semantic": "raw_gauge",
      "unit": "J",
      "scope": "active_world_registered_batteries",
      "completeness": "complete",
      "captured_at": "snapshot.ts"
    },
    "capacity_joules": {
      "source": "Components.Batteries(powerTransformer==null)+EnergyConsumers+Generators(excluding PowerTransformer)",
      "semantic": "raw_gauge",
      "unit": "J",
      "scope": "active_world_registered_batteries",
      "completeness": "complete",
      "captured_at": "snapshot.ts"
    },
    "battery_percent": {
      "source": "Components.Batteries(powerTransformer==null)+EnergyConsumers+Generators(excluding PowerTransformer)",
      "semantic": "derived_ratio",
      "unit": "percent",
      "scope": "active_world_registered_batteries",
      "completeness": "complete",
      "captured_at": "snapshot.ts"
    }
  },
  "action_gate": {
    "name": "percent_dependent_actions_eligible",
    "requires": [
      "storage_mode=bounded",
      "capacity_joules>0",
      "battery_percent=finite_consistent_number",
      "quality.power.battery_percent.status=observed"
    ]
  }
}
