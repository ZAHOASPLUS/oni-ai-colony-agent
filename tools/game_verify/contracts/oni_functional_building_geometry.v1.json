{
  "schema": "oni.functional-building-geometry-contract.v1",
  "payload_schema": "oni.functional_building_geometry.v1",
  "scope": "active_world",
  "capture_max_age_seconds": 5.0,
  "max_instances": 10000,
  "max_footprint_cells": 64,
  "status": "observed",
  "completeness": "complete",
  "mutating_condition_allowed": false,
  "payload_keys": ["captured_at", "complete", "instances", "schema", "world_id"],
  "instance_keys": ["footprint_cells", "instance_id", "orientation", "prefab_id", "root_cell", "world_id"],
  "instance_types": {
    "instance_id": "positive_int",
    "world_id": "nonnegative_int",
    "prefab_id": "nonempty_string",
    "orientation": "nonempty_string",
    "root_cell": "nonnegative_int",
    "footprint_cells": "sorted_unique_nonempty_int_array_max_64"
  },
  "source": "Components.BuildingCompletes.GetWorldItems(activeWorldId)+Building.Orientation+Building.GetBottomLeftCell+Building.PlacementCells",
  "quality_contract_id": "oni.qc.buildings.functional_geometry_instances.v1",
  "safety": {
    "unknown_on_error": true,
    "unknown_on_incomplete": true,
    "unknown_on_stale": true,
    "unknown_on_estimated": true,
    "unknown_on_world_mismatch": true,
    "unknown_on_race": true,
    "unknown_on_duplicate": true,
    "unknown_on_empty_footprint": true,
    "unknown_on_footprint_overflow": true,
    "actions": []
  }
}
