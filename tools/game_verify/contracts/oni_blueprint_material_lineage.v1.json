{
  "schema": "oni.blueprint-material-lineage-contract.v1",
  "payload_schema": "oni.blueprint_material_lineage.v1",
  "scope": "active_world_tracked_blueprint",
  "capture_max_age_seconds": 5.0,
  "max_items": 8,
  "status": "observed",
  "completeness": "complete_for_constructable",
  "mutating_condition_allowed": false,
  "item_keys": ["delivery_status", "delivered_mass_kg", "remaining_mass_kg", "required_mass_kg", "tag"],
  "delivery_statuses": ["complete", "pending", "unknown"],
  "mass_semantics": {
    "required_mass_kg": "recipe requirement",
    "delivered_mass_kg": "mass present in the blueprint Constructable Storage",
    "remaining_mass_kg": "max(required - delivered, 0) when storage read is valid",
    "unknown": "delivered and remaining must be null; no command authority"
  },
  "source": "Constructable.Recipe+Storage.GetMassAvailable",
  "quality_contract_id": "oni.qc.blueprints.material_lineage.v1",
  "safety": {
    "unknown_on_error": true,
    "unknown_on_incomplete": true,
    "unknown_on_stale": true,
    "unknown_on_world_mismatch": true,
    "reservation_not_delivery": true,
    "related_world_inventory_not_delivery": true,
    "actions": []
  }
}
