{
  "schema": "oni.functional-building-occupancy-contract.v1",
  "payload_schema": "oni.functional_building_occupancy.v1",
  "scope": "active_world",
  "capture_max_age_seconds": 5.0,
  "max_instances": 10000,
  "max_occupied_cells": 64,
  "status": "observed",
  "completeness": "complete",
  "mutating_condition_allowed": false,
  "payload_keys": ["captured_at", "complete", "instances", "schema", "world_id"],
  "instance_keys": ["entombed", "instance_id", "occupied_cells", "prefab_id", "world_id"],
  "instance_types": {
    "instance_id": "positive_int",
    "world_id": "nonnegative_int",
    "prefab_id": "nonempty_string",
    "entombed": "nullable_boolean",
    "occupied_cells": "nullable_sorted_unique_int_array_max_64"
  },
  "source": "Components.BuildingCompletes.GetWorldItems(activeWorldId)+Structure.IsEntombed+OccupyArea.GetOccupiedGridCells",
  "quality_contract_id": "oni.qc.buildings.functional_occupancy_instances.v1",
  "safety": {
    "unknown_on_error": true,
    "unknown_on_incomplete": true,
    "unknown_on_stale": true,
    "unknown_on_estimated": true,
    "unknown_on_world_mismatch": true,
    "unknown_on_race": true,
    "unknown_on_duplicate": true,
    "unknown_on_cells_overflow": true,
    "actions": []
  }
}
