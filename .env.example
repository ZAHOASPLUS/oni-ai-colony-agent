# Copy these names into the user environment or a private secrets directory.
# Do not commit a populated .env file and do not put the key in ONI/mod files.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Set to responses to use the OpenAI Responses API; chat_completions is the
# backwards-compatible default.
OPENAI_WIRE_API=responses

# Optional accounting (USD per one million tokens).
ONI_AI_INPUT_COST_PER_1M=
ONI_AI_OUTPUT_COST_PER_1M=
