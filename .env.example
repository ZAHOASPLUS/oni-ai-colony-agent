# Copy these names into the user environment or a private secrets directory.
# Do not commit a populated .env file and do not put the key in ONI/mod files.
#
# Used only by the DeepSeek player (agent/player_loop.py, agent/model_client.py):
# DeepSeek through the Cline-pass gateway.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.cline.bot/api/v1
OPENAI_MODEL=cline-pass/deepseek-v4.1-flash
# chat_completions for the Cline-pass/DeepSeek gateway; `responses` is the
# OpenAI-native protocol and is only served by OpenAI's own endpoints.
OPENAI_WIRE_API=chat_completions
ONI_AI_PROVIDER=cline-pass

# Accepted key aliases (the key and the endpoint must come from one source):
# CLINE_API_KEY, NEWAPI_API_KEY, DEEPSEEK_API_KEY, ONI_AI_API_KEY.
# Optional secrets-document fields: provider, base_url, model, wire_api.

# Optional accounting (USD per one million tokens).
ONI_AI_INPUT_COST_PER_1M=
ONI_AI_OUTPUT_COST_PER_1M=
