{
  "schema": "oni.agent-config.v1",
  "mode": "observer",
  "strategy": {
    "enabled": true,
    "profile": "survival_to_sustainable",
    "emit_markdown": true,
    "min_confidence": 0.55,
    "allow_estimated_metrics": true
  },
  "llm": {
    "enabled": false,
    "wire_api": "responses",
    "model": "gpt-4.1-mini",
    "max_calls_per_hour": 20,
    "require_human_approval": true
  },
  "safety": {
    "actions_enabled": false,
    "autopilot": false,
    "require_fresh_snapshot": true,
    "require_save_hash_allowlist": true,
    "never_mutate_save_files": true
  }
}
